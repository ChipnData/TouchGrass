{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Touch Grass",
  "mainBinaryName": "touch-grass",
  "version": "0.2.1",
  "identifier": "com.touchgrass.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Touch Grass",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0F1712"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Touch Grass",
    "shortDescription": "Lightweight unified game launcher",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyQURDM0NDNkQzNzc3RUYKUldUdmR6ZHR6TU90MGdmd1VXM0pUcVBDaXpNa3BrQ2xlQm40STRCYWNrMmwrNXNjT3ZwZ2pCdGgK",
      "endpoints": [
        "https://github.com/ChipnData/TouchGrass/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
